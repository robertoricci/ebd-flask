#!/bin/bash
set -e

# ── Função para limpar alembic_version ──────────────────────────────────────
reset_alembic() {
    echo "    Resetando alembic_version no banco..."
    python3 - << 'PYEOF'
import psycopg2, os
conn = psycopg2.connect(os.environ['DATABASE_URL'])
conn.autocommit = True
cur = conn.cursor()
cur.execute('DROP TABLE IF EXISTS alembic_version;')
conn.close()
print("    alembic_version removida com sucesso.")
PYEOF
}

# ── 1. Aguarda PostgreSQL ficar pronto ───────────────────────────────────────
echo "==> Aguardando PostgreSQL..."
python3 - << 'PYEOF'
import time, psycopg2, os
url = os.environ['DATABASE_URL']
for i in range(30):
    try:
        psycopg2.connect(url)
        print("    PostgreSQL pronto!")
        break
    except Exception as e:
        print(f"    Tentativa {i+1}/30... ({e})")
        time.sleep(2)
else:
    print("    ERRO: PostgreSQL não respondeu após 30 tentativas.")
    exit(1)
PYEOF

# ── 2. Inicializa pasta de migrations se necessário ──────────────────────────
echo "==> Verificando migrações..."
if [ ! -d "migrations" ]; then
    echo "    Pasta migrations não existe, inicializando..."
    flask db init
fi

# ── 3. Testa se o banco reconhece a revisão atual ────────────────────────────
echo "==> Verificando revisão do banco..."
flask db current 2>/tmp/db_current_err.txt || {
    ERR=$(cat /tmp/db_current_err.txt)
    if echo "$ERR" | grep -qE "Can't locate revision|No such revision"; then
        echo "    Revisão desconhecida detectada. Limpando..."
        reset_alembic
    fi
}

# ── 4. Gera migration automática ─────────────────────────────────────────────
echo "==> Gerando migration se necessário..."
flask db migrate -m "auto" 2>/tmp/migrate_err.txt || {
    ERR=$(cat /tmp/migrate_err.txt)
    if echo "$ERR" | grep -qE "Can't locate revision|No such revision"; then
        echo "    Revisão inválida no migrate, resetando..."
        reset_alembic
        flask db migrate -m "auto" 2>/dev/null || true
    else
        echo "    Nenhuma migration nova (ok)."
    fi
}

# ── 5. Aplica migrations ─────────────────────────────────────────────────────
echo "==> Aplicando migrations..."
flask db upgrade 2>/tmp/upgrade_err.txt || {
    ERR=$(cat /tmp/upgrade_err.txt)
    echo "    Erro no upgrade: $ERR"
    if echo "$ERR" | grep -qE "Can't locate revision|No such revision"; then
        echo "    Revisão inválida. Resetando e reaplicando..."
        reset_alembic
        flask db upgrade
    else
        echo "    Erro desconhecido, abortando."
        cat /tmp/upgrade_err.txt
        exit 1
    fi
}

echo "==> Migrations aplicadas com sucesso."

# ── 6. Seed ──────────────────────────────────────────────────────────────────
echo "==> Executando seed..."
python3 seed.py || echo "    Seed ignorado (dados já existem ou erro não crítico)."

# ── 7. Inicia servidor ───────────────────────────────────────────────────────
echo "==> Iniciando servidor Flask (desenvolvimento)..."
exec gunicorn \
    -w 2 \
    -b 0.0.0.0:5000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --log-level info \
    "wsgi:app"
